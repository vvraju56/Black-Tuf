{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "moduleDetection": "react",
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["tailwind.config.ts", "src/**/*.ts", "src/**/*.tsx"]
}
