# --- Deployment ---
# Public site URL (used for canonical URLs, OG tags, Firebase action links).
# Must be set on Vercel. Example: https://black-tuf.vercel.app
NEXT_PUBLIC_SITE_URL=https://black-tuf.vercel.app

# --- Supabase ---
# Copy from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the publishable/anon key for the browser; never the secret/service_role key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only service role key (Supabase Dashboard > Settings > API > service_role).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Firebase (secondary - authentication & push notifications) ---
# Find these in Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# Optional - Firebase Analytics web measurement id (not required for auth/push)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Get from Firebase Console > Project Settings > Cloud Messaging > Web configuration
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# Server-side Firebase Admin — the full service-account JSON (Firebase Console > Project Settings > Service Accounts > Generate new private key).
# On Vercel, store the JSON string as an environment variable (not as a file).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Shared secret for Supabase DB-trigger webhooks hitting /api/notifications/send
PUSH_WEBHOOK_SECRET=change-me
