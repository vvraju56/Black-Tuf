# The public URL of this website (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express API origin (used by the server and the /api/backend rewrite)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional server-only API origin (overrides NEXT_PUBLIC_API_URL on the server)
API_URL=

# Support identity shown across the site
NEXT_PUBLIC_SUPPORT_HANDLE=@blacktuftech

# Optional analytics provider ID. Leave empty to disable analytics.
NEXT_PUBLIC_ANALYTICS_ID=
