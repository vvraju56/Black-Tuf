# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blacktuf
MONGODB_URI=

# Optional. Only needed when the local DNS resolver refuses SRV queries
# (symptom: `querySrv ECONNREFUSED`). Example: 8.8.8.8,1.1.1.1
DNS_SERVERS=

# ── Authentication ────────────────────────────────────────────────────────
# Generate a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Initial admin account used by `npm run seed:admin`
ADMIN_NAME=BlackTuf Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Cloudinary (image + attachment storage) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Frontend / CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
FRONTEND_URL=http://localhost:3000
